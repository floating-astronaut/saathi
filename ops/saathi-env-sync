#!/usr/bin/env bash
# Pull the runtime secrets from Secrets Manager into the box's on-disk files.
#
#   saathi/dev/runtime  (a flat JSON of KEY->value)  ->  ~/saathi/.env   (0600)
#   saathi/dev/gcp-sa   (the GCP service-account JSON) ->  ~/saathi-gcp-sa.json (0600)
#
# The secret is the source of truth; `.env` is rewritten from it, so a value only
# in `.env` is lost on the next run — put it in the secret with `ops/set-secret.sh`.
# Read via the instance role (IndofolkDevBoxRole has GetSecretValue on saathi/dev/*),
# so no profile and no key material on disk. Value-blind: this never prints a secret,
# only key counts and SHA-256 prefixes.
#
# This lived only in /usr/local/bin on the original box until 2026-07-30, so the
# successor box aborted every `ops/deploy.sh` at `saathi-env-sync: command not found`.
# It is in the repo now, and `ops/deploy_onbox.sh` installs it before the deploy that
# needs it — see RUNTIME-ENVSYNC-1.
set -euo pipefail

SECRET_RUNTIME="saathi/dev/runtime"
SECRET_GCP_SA="saathi/dev/gcp-sa"
REGION="${SAATHI_REGION:-ap-south-1}"
VENV_PY="/home/ubuntu/saathi/.venv/bin/python"
[ -x "$VENV_PY" ] || VENV_PY="$(command -v python3)"

SECRET_RUNTIME="$SECRET_RUNTIME" SECRET_GCP_SA="$SECRET_GCP_SA" REGION="$REGION" \
"$VENV_PY" - <<'PY'
import hashlib, json, os, pwd, shutil, tempfile

REGION = os.environ["REGION"]
HOME = "/home/ubuntu"
ENV_PATH = f"{HOME}/saathi/.env"
SA_PATH = f"{HOME}/saathi-gcp-sa.json"

import boto3
sm = boto3.client("secretsmanager", region_name=REGION)

pw = pwd.getpwnam("ubuntu")
uid, gid = pw.pw_uid, pw.pw_gid
is_root = os.geteuid() == 0

def short(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()[:12]

def write_private(path: str, data: bytes) -> None:
    """Atomic, 0600, owned by ubuntu. temp+rename so a crash never leaves a
    half-written secrets file that a service would then start against."""
    d = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".envsync-")
    try:
        os.write(fd, data)
        os.close(fd)
        os.chmod(tmp, 0o600)
        if is_root:
            os.chown(tmp, uid, gid)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise

# --- GCP service account -----------------------------------------------------
sa = sm.get_secret_value(SecretId=os.environ["SECRET_GCP_SA"])["SecretString"]
json.loads(sa)  # fail loudly if it is not the JSON a service will try to load
write_private(SA_PATH, sa.encode())
print(f"  {SA_PATH}  (0600, ubuntu)  sha={short(sa.encode())}")

# --- runtime env -------------------------------------------------------------
runtime = json.loads(sm.get_secret_value(SecretId=os.environ["SECRET_RUNTIME"])["SecretString"])
if not isinstance(runtime, dict) or not runtime:
    raise SystemExit("runtime secret is not a non-empty JSON object — refusing to write .env")

if os.path.exists(ENV_PATH):
    bak = f"{ENV_PATH}.bak-envsync"
    shutil.copy2(ENV_PATH, bak)
    os.chmod(bak, 0o600)
    if is_root:
        os.chown(bak, uid, gid)

header = ("# Generated by saathi-env-sync from Secrets Manager saathi/dev/runtime.\n"
          "# Do not edit — this file is rewritten on every deploy. Change the secret\n"
          "# with ops/set-secret.sh instead.\n")
body = "".join(f"{k}={runtime[k]}\n" for k in sorted(runtime))
write_private(ENV_PATH, (header + body).encode())
print(f"  {ENV_PATH}  (0600, ubuntu)  {len(runtime)} keys  sha={short(body.encode())}")
PY
echo "saathi-env-sync: ok"
